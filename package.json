{
  "name": "foodily",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/admin_web",
    "services/api",
    "packages/contracts"
  ],
  "scripts": {
    "dev:admin": "npm --workspace apps/admin_web run dev",
    "dev:api": "npm --workspace services/api run start:dev",
    "build:admin": "npm --workspace apps/admin_web run build",
    "build:api": "npm --workspace services/api run build",
    "test:api": "npm --workspace services/api run test",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "lint:openapi": "npx @redocly/cli lint packages/contracts/openapi/foodily-v1.yaml"
  }
}
